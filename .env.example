# ── Required in production ────────────────────────────────────────────────
# Public URL, used for links in e-mails
PUBLIC_URL=https://helfen.example.de
# Only for docker-compose.yml: password of the bundled PostgreSQL
POSTGRES_PASSWORD=change-me

# ── Only for docker-compose.yml ──────────────────────────────────────────
# Host port the app is published on, and the address it binds to.
# 127.0.0.1 = only reachable from this machine (reverse proxy on the host);
# 0.0.0.0 = reachable from the network.
# WICHTEL_PORT=3006
# WICHTEL_BIND=127.0.0.1
# Image to run (default: ghcr.io/yniverz/wichtel:latest)
# WICHTEL_IMAGE=

# PostgreSQL connection. Leave unset in development to use an embedded
# database in ./data (PGlite), or use pglite://memory for a throwaway one.
# DATABASE_URL=postgres://wichtel:password@localhost:5432/wichtel

# ── E-mail (SMTP). Without SMTP_HOST, e-mails are printed to the log and new
#    accounts need no e-mail confirmation. ─────────────────────────────────
# SMTP_HOST=mail.example.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=helfen@example.de
# SMTP_PASSWORD=
# SMTP_FROM="Festival Helfende <helfen@example.de>"

# ── Optional ─────────────────────────────────────────────────────────────
# Fixed token for the first-run setup link, at least 24 characters (otherwise a random
# one is logged). Remove it once setup is done.
# SETUP_TOKEN=
# Where uploaded logos/backgrounds are stored (Docker: /data/uploads)
# UPLOAD_DIR=./data/uploads
# Logging: debug | info | warn | error, and json | text (default: json in production)
# LOG_LEVEL=info
# LOG_FORMAT=json
# Without SMTP: also log e-mail texts (they contain password-reset links). Development only.
# LOG_MAIL_BODIES=false
