# ── Required in production ────────────────────────────────────────────────
# Public URL, used for links in e-mails
PUBLIC_URL=https://helfen.example.de
# Only for docker-compose.yml: password of the bundled PostgreSQL
POSTGRES_PASSWORD=change-me

# PostgreSQL connection. Leave unset in development to use an embedded
# database in ./data (PGlite), or use pglite://memory for a throwaway one.
# DATABASE_URL=postgres://wichtel:password@localhost:5432/wichtel

# ── E-mail (SMTP). Without SMTP_HOST, e-mails are printed to the log. ─────
# SMTP_HOST=mail.example.de
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=helfen@example.de
# SMTP_PASSWORD=
# SMTP_FROM="Festival Helfende <helfen@example.de>"

# ── Optional ─────────────────────────────────────────────────────────────
# Fixed token for the first-run setup link (otherwise a random one is logged)
# SETUP_TOKEN=
# Where uploaded logos/backgrounds are stored (Docker: /data/uploads)
# UPLOAD_DIR=./data/uploads
